# =============================================================================
# agent-platform 环境变量模板（唯一配置入口 src/agent_platform/settings.py 的镜像）
# 使用：复制为 .env 并填入真实值；.env 严禁入库（CLAUDE.md 10.1 / NO-17）。
# 必填项缺失时服务启动即 fail-fast 报错并打印缺失变量名（CLAUDE.md 3.5）。
# 修改本文件必须同步 settings.py 与 CHANGELOG.md（NO-20）。
# =============================================================================

# --- 运行环境 ---
APP_ENV=dev                        # dev | test | staging | prod
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR（生产默认 INFO）

# --- HTTP 服务 ---
AGENT_API_HOST=0.0.0.0
AGENT_API_PORT=8000
# 演示期静态 Bearer Token（生产改为 OIDC/JWT 校验）；必填，无默认值
AGENT_API_BEARER_TOKEN=
# 演示期租户与用户标识（生产由认证令牌解析，禁止前端传入，CLAUDE.md 10.2 / NO-19）
DEMO_TENANT_ID=demo
DEMO_USER_ID=demo_user
SSE_HEARTBEAT_S=15                 # SSE 心跳间隔（保活）
READYZ_TIMEOUT_S=3                 # /readyz 单个依赖探测超时（CLAUDE.md 11.6）
MAX_QUESTION_CHARS=2000            # 单次提问字符上限，超限在 HTTP 边界 422（不触发检索/模型）

# --- 持久化：PostgreSQL（LangGraph checkpoint / store）---
# 主机名务必写 127.0.0.1，**不要写 localhost**：本机 localhost 会先解析到 IPv6 ::1，
# 而 Docker Desktop 只把 Postgres 发布在 IPv4 上，libpq 会先在 ::1 上卡满整个建连超时
# 再回落到 IPv4（实测 10.1s vs 127.0.0.1 的 0.0s）。详见 core/checkpoint.py。
POSTGRES_DSN=postgresql://ragflow_demo:CHANGE_ME@127.0.0.1:5432/agent_platform
POSTGRES_CONNECT_TIMEOUT_S=10      # 建连超时（秒）；DSN 里若自带 connect_timeout 则以 DSN 为准
# Redis（LangGraph 任务队列/缓存；RAGFlow 占用宿主 6379，本项目映射 6380）
REDIS_URL=redis://localhost:6380/0

# --- 模型网关：LiteLLM Proxy（CLAUDE.md 5.1 / NO-02：业务代码不得直连厂商）---
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=                      # 对应 litellm config 的 LITELLM_MASTER_KEY；必填
PRIMARY_CHAT_MODEL=primary-chat    # 逻辑名，网关映射到具体型号（当前 deepseek-chat）
FALLBACK_CHAT_MODEL=               # 应用层备选模型逻辑名。当前**留空**：网关未配 fallback 链（见下方"已知缺口"）
EMBEDDING_MODEL=embedding          # 逻辑名，网关映射到 Qwen3-Embedding（当前 SiliconFlow 云端）
RERANK_MODEL=rerank                # 逻辑名，网关映射到 Qwen3-Reranker（当前 SiliconFlow 云端）
JUDGE_MODEL=judge                  # 逻辑名，评估裁判模型；仅评估层使用（CLAUDE.md 9.2）。
                                   # ⚠ 网关把 judge 指向云端 Qwen（SiliconFlow），与生成模型
                                   # primary-chat（DeepSeek）不同家族，没有同源自偏好偏置；
                                   # 但评估数据会出域，仅限公开演示语料，生产须换私有化裁判。
                                   # 详见 docs/adr/0005-cloud-qwen-judge.md
JUDGE_UPSTREAM_MODEL=Qwen/Qwen3.5-122B-A10B
                                   # 网关 judge 路由背后的上游型号：只做产物留痕与判分
                                   # 缓存键，不参与路由；必须与 litellm config 保持一致。
                                   # 留空表示未记录（旧产物即如此，不得当成某个默认型号）。
MODEL_TIMEOUT_S=120                # 单次模型调用超时
MODEL_MAX_RETRIES=2                # 模型调用最大重试次数（仅超时/429/5xx）

# --- 知识后端：RAGFlow（文档工程：解析/OCR/切分/文档管理）---
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=                   # RAGFlow 控制台生成的 API Key；必填
RAGFLOW_DATASET_NAME=gov_policy    # 目标数据集名称（不存在则自动创建）
RAGFLOW_PARSE_TIMEOUT_S=3600       # 单文档解析等待上限（扫描件 OCR 慢）
# 数据集级解析配置（ADR-0004）：RAGFlow 的上传接口只白名单 table_column_* 两个键，
# 下面这些必须在创建/更新数据集时设置，逐文件传会被客户端显式拒绝。
RAGFLOW_LAYOUT_RECOGNIZE=DeepDOC   # 版面/表格识别器；DeepDOC 启用 OCR 与表格结构识别
RAGFLOW_IMAGE_CONTEXT_SIZE=0       # 图片切分上溯的相邻文本字符数
RAGFLOW_TABLE_CONTEXT_SIZE=0       # 表格切分上溯的相邻文本字符数
RAGFLOW_CHUNK_TOKEN_NUM=512
RAGFLOW_TASK_PAGE_SIZE=12          # 解析任务分片页数（CPU 模式下影响单任务耗时）
# 列表接口的 doc_type_kwd 会被上游压成 text，入库逐条读详情取真实类型（ADR-0004）
RAGFLOW_CHUNK_DETAIL_CONCURRENCY=8

# --- 证据图片（ADR-0004；演示期本地文件存储，生产换 MinIO/S3）---
EVIDENCE_IMAGE_STORE_DIR=local_data/evidence_images
EVIDENCE_IMAGE_MAX_BYTES=8388608   # 单张图片字节上限（8 MiB）
EVIDENCE_IMAGE_DOWNLOAD_TIMEOUT_S=60
EVIDENCE_IMAGE_DOWNLOAD_CONCURRENCY=4  # 入库时并发下载图片的上限

# --- 向量库：Milvus（检索主链路，ADR-0002）---
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=                      # 本地 standalone 留空；Zilliz 云填 Token
# v2 集合含 media_type / images 字段（ADR-0004）；旧集合 gov_policy_chunks 保留用于回滚
MILVUS_COLLECTION=gov_policy_chunks_v2
MILVUS_DIM=4096                    # 必须与网关 embedding 输出维度一致（不符 upsert fail-fast）

# --- 检索策略（变更属检索质量变更，须过评估门禁 CLAUDE.md 9.2 / NO-16）---
EVIDENCE_TOP_K=8                   # rerank 后进入上下文的证据条数
RETRIEVAL_CANDIDATES=64            # 混合检索候选数（送 rerank 前）
SIMILARITY_THRESHOLD=0.2           # 混合检索相似度下限
RERANK_SCORE_THRESHOLD=0.3         # rerank 分数下限，低于此视为证据不足
HYBRID_VECTOR_WEIGHT=0.7           # 混合检索中稠密向量权重（1-该值为 BM25 权重）

# --- 入库脚本 ---
INGEST_MANIFEST_PATH=local_data/ingest_manifest.json   # 幂等清单（源路径+内容hash）；目录已 gitignore

# --- 测试 ---
RUN_INTEGRATION_TESTS=false        # true 时运行需真实基础设施的集成测试（CLAUDE.md 9.3）
RUN_EVAL_TESTS=false               # true 时运行需真实基础设施 + 裁判模型的评估测试
                                   # （默认 skip；刻意不进 pre-commit，见 CHANGELOG）

# --- 评估：RAGAS（ADR-0006，`eval` 依赖组）---
RAGAS_DO_NOT_TRACK=true            # 必须**字面等于** true：ragas 启动即外发遥测（含稳定 UUID
                                   # 与模型名），属数据出域（10.1；NO-15 的立法意图）。该库
                                   # 只在字面 "true" 时才停止外发，填 1/yes/True 一律无效。
                                   # evaluation/ragas_backend.py 在 import ragas 之前**强制
                                   # 覆盖**此值，且不提供关闭开关；写在这里是给"绕过评估代码
                                   # 直接 import ragas"的人看的——那是唯一的漏口。
                                   # 注：该变量由 ragas 库直接读取，**不**经 settings.py。
                                   # RAGAS 只在 `uv run --group eval` 下安装，默认环境与
                                   # 生产镜像不得包含（NO-14 的授权边界）。

# =============================================================================
# 以下变量由 docker-compose.yml 读取，**不**进入 settings.py。
# 必须在这里出现：compose 对它们标了 :?（缺失即拒绝启动），
# 只按上面的 settings 清单填写会让 docker compose up -d 直接失败。
# =============================================================================

# --- PostgreSQL 容器 ---（POSTGRES_DSN 里的 user:password@db 必须与此处三者一致，
#                        否则应用连得上库、却是另一个库或直接认证失败）
POSTGRES_USER=ragflow_demo
POSTGRES_PASSWORD=                 # 必填：compose 标了 :? ；与 POSTGRES_DSN 保持一致
POSTGRES_DB=agent_platform

# --- Milvus 的 MinIO（对象存储；仅本机演示，生产改由 K8s Secret 注入）---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- LiteLLM 容器 ---
LITELLM_SALT_KEY=                  # 必填：凭据加密用的盐，缺失时 LiteLLM 拒绝启动
DEEPSEEK_API_KEY=                  # 必填：litellm config 的 primary-chat 提供方
SILICONFLOW_API_KEY=               # 必填：litellm config 的 embedding / rerank / judge 提供方

# =============================================================================
# 已知缺口（写在这里，避免被误当成"已配好"）：
#
# - 模型 fallback 链（CLAUDE.md 5.4）：网关侧未配 router_settings.fallbacks，
#   应用侧 FALLBACK_CHAT_MODEL 也留空 —— 目前只有 DeepSeek 一家对话模型密钥，
#   补了第二家才谈得上 fallback。详见 deploy/docker/litellm/config.yaml 末段。
# - Langfuse / OTel（CLAUDE.md 9.1）、NeMo Guardrails + Presidio（10.3）：
#   仍为接口占位（core/tracing.py 已就绪但未接线；container.py 传 guardrail=None）。
# - 评估裁判模型仍指向云端（JUDGE_MODEL=judge 经网关映射到 SiliconFlow 的 Qwen）：
#   §5.8 要求私有化场景用**本地**裁判模型，故这是**演示期偏离**，与嵌入/重排
#   经网关指向云端同性质（见 ADR-0002 / ADR-0005），**仅限公开演示语料**。
#   换型后与生成模型不同家族，自偏好偏置消除；但评估数据（问题、证据、答案）
#   仍会出域，这一点没有变。
# - RAGAS 已进 `eval` 依赖组并精确锁定 0.4.3（ADR-0006）；但该库约 9 个月无发布，
#   且 `StrictAnswerCorrectness` 依赖其私有方法——升级前必须重验空断言防护。
#   RAGAS 与引用裁判共用云端 Qwen，评估数据（含参考答案）会出域，仅限公开演示语料。
# - 评估的既有质量缺陷与评审协议：见 tests/evals/README.md（第五节）与 ADR-0003。
# =============================================================================
