# --- 密钥与环境（NO-17：.env 严禁入库，只提交 .env.example）---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.hypothesis/

# --- uv ---
.uv/
uv.toml

# --- 本地数据与运行时产物（语料、索引、备份均不入库）---
data/
*.db
*.sqlite3
# 本仓 compose 的卷都落在这里（postgres/、milvus/）。
# 注意：.gitignore 的 `#` **只在行首**才是注释，行尾注释会被当成模式的一部分、
# 使整行失效（实测：写成 `local_data/   # 说明` 后 git check-ignore 返回 1）。
local_data/
artifacts/
# 上游 Milvus 官方 compose 的卷惯例是 ./volumes/；本仓未采用（统一放 local_data/），
# 此处仍拦一道：万一有人照上游写法加卷，不至于把数 GB 索引提交进仓库。
deploy/docker/*/volumes/

# --- IDE / 编辑器 ---
.idea/
.vscode/
*.swp
*.swo

# --- OS ---
Thumbs.db
desktop.ini
.DS_Store

# --- 日志 ---
*.log
logs/
