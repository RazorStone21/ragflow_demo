{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.prod)",
      "Read(./local_data/**)",
      "Bash(git push:*)",
      "Bash(git commit:* --no-verify:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)"
    ],
    "ask": [
      "Bash(uv add:*)",
      "Bash(uv remove:*)",
      "Bash(uv lock:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git branch -D:*)",
      "Bash(rm:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose rm:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker system prune:*)"
    ]
  }
}
